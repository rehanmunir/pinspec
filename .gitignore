/.bundle/
/pkg/
/tmp/
/coverage/
Gemfile.lock
.DS_Store
*.gem

# Fixture app artifacts
spec/fixtures/apps/*/tmp/
spec/fixtures/apps/*/log/
spec/fixtures/apps/*/Gemfile.lock

# pinspec's own output inside the fixture apps. These are regenerated by the
# integration and equivalence specs on every run, so committing them would mean a
# diff on every test run and a reviewer reading generated files as source.
spec/fixtures/apps/*/spec/characterization/
