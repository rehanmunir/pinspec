/.bundle/
/pkg/
/tmp/
/coverage/
/Gemfile.lock
.DS_Store
*.gem

# Fixture app artifacts
spec/fixtures/apps/*/tmp/
spec/fixtures/apps/*/log/

# Only the two applications that really boot have a GENERATED lock, produced by
# `bundle install` when preparing them. Every other fixture's Gemfile.lock is
# hand-written test data - AppProfileReader reads it to detect gems, the Rails
# version and the Ruby version - so a blanket rule here kept twelve required
# fixtures out of the repository and left the suite passing only on the machine
# that wrote them.
spec/fixtures/apps/rails71_basic/Gemfile.lock
spec/fixtures/apps/rails61_legacy/Gemfile.lock

# pinspec's own output inside the fixture apps. These are regenerated by the
# integration and equivalence specs on every run, so committing them would mean a
# diff on every test run and a reviewer reading generated files as source.
spec/fixtures/apps/*/spec/characterization/
